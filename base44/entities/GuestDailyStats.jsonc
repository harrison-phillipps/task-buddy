{
  "name": "GuestDailyStats",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "UTC day (YYYY-MM-DD) this counter covers"
    },
    "breakdowns": {
      "type": "number",
      "default": 0,
      "description": "Guest breakdowns attempted on that day"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}