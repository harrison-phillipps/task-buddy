{
  "name": "WinsJournal",
  "type": "object",
  "properties": {
    "entry_date": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD"
    },
    "wins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of wins for the day"
    },
    "mood": {
      "type": "string",
      "enum": [
        "amazing",
        "good",
        "okay",
        "tough"
      ],
      "default": "good"
    },
    "reflection": {
      "type": "string",
      "description": "Optional end-of-day reflection note"
    }
  },
  "required": [
    "entry_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}