{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Team or workspace name"
    },
    "description": {
      "type": "string",
      "description": "Team description or purpose"
    },
    "owner_id": {
      "type": "string",
      "description": "User ID of the team owner"
    },
    "owner_name": {
      "type": "string",
      "description": "Display name of the team owner"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the team owner"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member",
              "viewer"
            ],
            "default": "member"
          }
        }
      },
      "default": [],
      "description": "Array of team members with their details"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Array of user IDs who are team members (for backward compatibility)"
    },
    "member_roles": {
      "type": "object",
      "description": "Map of user IDs to roles (admin, member, viewer)",
      "default": {}
    },
    "invite_code": {
      "type": "string",
      "description": "Unique code for inviting members"
    },
    "color": {
      "type": "string",
      "default": "#8B5CF6",
      "description": "Team color for visual identification"
    }
  },
  "required": [
    "name",
    "owner_id"
  ]
}