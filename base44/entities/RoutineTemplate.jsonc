{
  "name": "RoutineTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name (e.g. Morning Routine)"
    },
    "description": {
      "type": "string",
      "description": "Short description of the routine"
    },
    "routine_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "custom"
      ],
      "default": "daily",
      "description": "Intended cadence for this routine"
    },
    "tasks": {
      "type": "array",
      "description": "Task definitions in this template",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "difficulty": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "energy_level_needed": {
            "type": "string"
          },
          "estimated_minutes": {
            "type": "number"
          },
          "recurrence_pattern": {
            "type": "string"
          },
          "recurrence_interval": {
            "type": "number"
          },
          "recurrence_days": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "recurrence_end_date": {
            "type": "string"
          },
          "subtasks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}