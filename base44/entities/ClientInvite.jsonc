{
  "name": "ClientInvite",
  "type": "object",
  "properties": {
    "clinician_user_id": {
      "type": "string",
      "description": "User ID of the clinician sending the invite"
    },
    "clinician_name": {
      "type": "string"
    },
    "clinician_organisation": {
      "type": "string"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique code sent to client"
    },
    "client_email": {
      "type": "string",
      "description": "Email of the invited client"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "required"
      ],
      "default": "pending"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "clinician_user_id",
    "invite_code"
  ]
}