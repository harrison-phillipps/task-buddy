{
  "name": "RlsProbeRecord",
  "type": "object",
  "properties": {
    "entity_name": {
      "type": "string",
      "enum": [
        "ActiveSession",
        "TeamNotification",
        "TeamMessage"
      ],
      "description": "Entity the sentinel row lives in. This row is the ONLY authority for treating a record as a sentinel: a record with no row here is refused by rlsProbeRowTouch."
    },
    "record_id": {
      "type": "string",
      "description": "Exact id of the sentinel record created by rlsProbeRowSetup."
    },
    "role": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ],
      "description": "A = owner only, must stay invisible to a non-member. B = owner plus extra member accounts, must be visible to them."
    },
    "label": {
      "type": "string",
      "description": "Human label, e.g. TeamMessage-A"
    }
  },
  "required": [
    "entity_name",
    "record_id",
    "role"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}