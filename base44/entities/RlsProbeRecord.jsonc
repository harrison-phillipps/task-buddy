{
  "name": "RlsProbeRecord",
  "type": "object",
  "properties": {
    "entity_name": {
      "type": "string",
      "enum": [
        "ActiveSession",
        "TeamNotification",
        "TeamMessage",
        "Task",
        "CollaborativeFocusSession",
        "CalendarEvent",
        "NotificationPreferences",
        "TeamTemplate",
        "Leaderboard",
        "TaskComment",
        "TaskActivity"
      ],
      "description": "Entity the sentinel row lives in. This row is the ONLY authority for treating a record as a sentinel: a record with no row here is refused by rlsProbeRowTouch."
    },
    "record_id": {
      "type": "string",
      "description": "Exact id of the sentinel record created by rlsProbeRowSetup."
    },
    "role": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "description": "A = the first probe account's own row (foreign to the other). B = the second probe account's own row. C = a row neither probe account owns (shared member snapshot or a third owner)."
    },
    "label": {
      "type": "string",
      "description": "Human label, e.g. TeamMessage-A or Task-C"
    }
  },
  "required": [
    "entity_name",
    "record_id",
    "role"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}