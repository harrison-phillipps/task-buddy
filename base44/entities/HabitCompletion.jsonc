{
  "name": "HabitCompletion",
  "type": "object",
  "properties": {
    "habit_id": {
      "type": "string",
      "description": "ID of the habit"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD"
    },
    "count": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "habit_id",
    "completion_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}