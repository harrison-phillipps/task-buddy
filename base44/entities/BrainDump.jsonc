{
  "name": "BrainDump",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owning user. Carries ownership for records created before created_by_id was correct (system field cannot be rewritten). REQUIRED: the data.user_id branch in every rule (read, update, delete) exists for legacy rows whose created_by_id points at a deleted account - removing that branch hides the row from its owner instead of merely blocking edits. 14 rows depend on it."
    },
    "content": {
      "type": "string",
      "description": "The raw brain dump text"
    },
    "tasks_created": {
      "type": "number",
      "description": "Number of tasks created from this brain dump"
    },
    "task_ids": {
      "type": "array",
      "description": "IDs of tasks created from this brain dump",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "encouragement": {
      "type": "string",
      "description": "AI encouragement message"
    },
    "team_id": {
      "type": "string",
      "description": "Team ID if this is a team brain dump"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}