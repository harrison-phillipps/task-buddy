{
  "name": "TeamMessage",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string",
      "description": "ID of the team this message belongs to"
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Snapshot of the team's member user ids at write time. Nullable: absent until backfilled. Lets a read rule scope messages to team members without a join to Team."
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user who sent the message"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the sender"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "reply_to": {
      "type": "string",
      "description": "ID of the message this is replying to"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "URLs of attached files"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Whether this message is pinned"
    }
  },
  "required": [
    "team_id",
    "user_id",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}