{
  "name": "NotificationPreferences",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User these preferences belong to. The owner anchor for every rule: only this user (and an admin) may read or change the row."
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone for quiet-hours and focus-nudge evaluation, e.g. \"Australia/Adelaide\". Filled silently from Intl.DateTimeFormat().resolvedOptions().timeZone on app load when empty. Absent or invalid falls back to Australia/Adelaide for quiet hours (see base44/shared/quietHours.ts); the focus nudge skips a user with no usable timezone instead of guessing."
    },
    "task_reminders": {
      "type": "boolean",
      "default": true,
      "description": "Enable task due date reminders"
    },
    "task_reminder_minutes": {
      "type": "number",
      "default": 60,
      "description": "Minutes before due date to remind"
    },
    "goal_reminders": {
      "type": "boolean",
      "default": true,
      "description": "Enable goal deadline reminders"
    },
    "goal_reminder_days": {
      "type": "number",
      "default": 7,
      "description": "Days before deadline to remind"
    },
    "habit_reminders": {
      "type": "boolean",
      "default": true,
      "description": "Enable daily habit reminders"
    },
    "achievement_notifications": {
      "type": "boolean",
      "default": true,
      "description": "Get notified for achievements"
    },
    "team_notifications": {
      "type": "boolean",
      "default": true,
      "description": "Enable team-related notifications"
    },
    "email_notifications": {
      "type": "boolean",
      "default": true,
      "description": "Send email for critical notifications"
    },
    "email_digest": {
      "type": "string",
      "enum": [
        "none",
        "daily",
        "weekly"
      ],
      "default": "daily",
      "description": "Email digest frequency"
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable quiet hours"
    },
    "quiet_hours_user_set": {
      "type": "boolean",
      "description": "True once the user has saved the Quiet Hours card. Makes quiet_hours_enabled: false an explicit opt-out: isQuietNow returns not-quiet instead of applying the 21:00-07:30 default. Absent means the row has never been touched, so the default window still applies."
    },
    "quiet_hours_start": {
      "type": "string",
      "description": "Quiet hours start time (HH:mm)"
    },
    "quiet_hours_end": {
      "type": "string",
      "description": "Quiet hours end time (HH:mm)"
    },
    "focus_nudge_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Opted in to the gentle focus nudge. False (or absent) means this user is never nudged. Only ever set true by the user's own opt-in, and set back to false when they switch it off in Settings."
    },
    "focus_nudge_time": {
      "type": "string",
      "description": "The local wall-clock time the user chose for their nudge, \"HH:mm\", read in this row's own timezone. The sweep sends inside [this time, +15 minutes). Never inferred \u2014 only written when the user picks a time."
    },
    "focus_nudge_paused": {
      "type": "boolean",
      "default": false,
      "description": "Set by sendFocusNudges after three consecutive nudges went unanswered. A paused user is skipped until they switch the nudge back on in Settings, which clears this."
    },
    "focus_nudge_ignored_count": {
      "type": "number",
      "default": 0,
      "description": "Consecutive nudges with no focus session inside their 3-hour window. Any session start resets it to 0; at 3 the nudge pauses itself."
    },
    "focus_nudge_last_sent_local_date": {
      "type": "string",
      "description": "The user's own local date (YYYY-MM-DD) the last nudge was delivered on. This is what enforces at most one nudge per day, in their calendar rather than the server's."
    },
    "focus_nudge_last_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last nudge was actually delivered. Written only after OneSignal confirmed the send, so a failed delivery never consumes the day."
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}