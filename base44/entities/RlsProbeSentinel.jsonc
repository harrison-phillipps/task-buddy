{
  "name": "RlsProbeSentinel",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string",
      "description": "Exact id of a throwaway probe team created by rlsProbeSetup. This row is the ONLY authority for treating a team as a sentinel: a team merely named zzProbe-* has no row here and is refused."
    },
    "label": {
      "type": "string",
      "description": "Sentinel label, e.g. zzProbe-A / zzProbe-B"
    }
  },
  "required": [
    "team_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}