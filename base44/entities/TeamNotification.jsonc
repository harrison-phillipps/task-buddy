{
  "name": "TeamNotification",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string",
      "description": "Team this notification belongs to"
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Snapshot of the team's member user ids at write time. Nullable: absent until backfilled. A read rule can only see fields on the row, so this is what lets a notification be scoped to team members without a join to Team."
    },
    "type": {
      "type": "string",
      "enum": [
        "task_assigned",
        "task_commented",
        "status_changed",
        "deadline_reminder",
        "session_started",
        "task_completed",
        "general"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Notification priority"
    },
    "related_id": {
      "type": "string",
      "description": "ID of related task/session"
    },
    "created_by": {
      "type": "string",
      "description": "User who created the notification"
    },
    "acknowledged_by": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "acknowledged_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Users who have acknowledged this notification"
    }
  },
  "required": [
    "team_id",
    "type",
    "title",
    "message"
  ]
}