{
  "name": "User",
  "type": "object",
  "properties": {
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID linked to this user"
    },
    "display_name": {
      "type": "string",
      "description": "User-set display name shown throughout the app"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "ai_consent_given": {
      "type": "boolean",
      "description": "Consent to AI task breakdown. null = not yet asked, true = agreed, false = declined. Re-prompt on next breakdown tap when false or null."
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp set when the user initiates account deletion. While set, RevenueCatWebhook and stripeWebhook ignore events for this user. Cleared on a timeout so an incomplete deletion isn't permanently ignored."
    }
  }
}