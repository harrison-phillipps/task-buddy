      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "calendar_provider": {
      "type": "string",
      "enum": [
        "google",
        "outlook"
      ]
    },
    "calendar_connected": {
      "type": "boolean"
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "child",
        "teen",
        "adult"
      ],
      "description": "Age-based profile type for personalisation"
    }
  },
  "required": [
