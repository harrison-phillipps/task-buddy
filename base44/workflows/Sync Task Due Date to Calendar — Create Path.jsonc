{
  "name": "Sync Task Due Date to Calendar \u2014 Create Path",
  "description": "Fires when a task with a due_date is created, pushing the deadline to the user's connected Google or Outlook calendar.",
  "trigger": {
    "condition": "${ (.trigger.data.due_date != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Task"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_task_due_date_to_calendar_create_path",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushTaskToCalendar",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "pushTaskToCalendar"
  }
}