{
  "name": "Spawn Next Recurring Task on Completion",
  "description": "When a recurring task instance is marked completed, automatically creates the next instance based on the recurrence pattern.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Task"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "spawn_next_recurring_task_on_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recurringTaskHandler",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "recurringTaskHandler"
  }
}