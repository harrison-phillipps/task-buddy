{
  "name": "Sync Task Due Date to Calendar",
  "description": "Automatically pushes task deadlines to connected Google or Outlook calendar when a task with a due date is created or updated.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"due_date\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Task"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_task_due_date_to_calendar",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushTaskToCalendar",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "pushTaskToCalendar"
  }
}